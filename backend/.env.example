# ─────────────────────────────────────────────────────────────
# Start A New Life — Backend Environment Variables
# Copy this to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# SQLite database path (relative to backend/)
DB_PATH=./data/sanl.db

# CORS — comma-separated list of allowed origins
# For Expo Go: exp://192.168.x.x:8081 or just * for dev
CORS_ORIGIN=*

# ── Gemini AI (server-side key — never expose to client) ─────
# Get your free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ── Redis Cache ───────────────────────────────────────────────
# Option A: full URL (takes priority — recommended for Railway / Render)
# REDIS_URL=redis://default:password@host:6379

# Option B: individual fields (used when REDIS_URL is not set)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password   # leave commented for local dev
REDIS_DB=2
